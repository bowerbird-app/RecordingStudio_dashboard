<% dummy_page_nav(title: "Template Demo", back_url: root_path) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Template Demo",
    subtitle: "This dummy app is the browser-facing demo surface for the template.",
    variant: :h1
  ) %>

  <div class="grid gap-6 lg:grid-cols-2">
    <%= render FlatPack::Card::Component.new do |card| %>
      <% card.body do %>
        <div class="space-y-2">
          <div class="space-y-1">
            <h3 class="text-lg font-semibold leading-tight">What's working</h3>
            <p class="text-sm leading-6 text-(--surface-muted-content-color)">Core template capabilities already wired into the dummy app.</p>
          </div>
          <ul class="space-y-3 text-sm leading-6">
            <li>Rails engine routes are mounted and responding.</li>
            <li>PostgreSQL UUID-oriented migrations are included in the engine.</li>
            <li>Tailwind sources can be wired into a host app through the install generator.</li>
            <li>The dummy app exercises authentication, the Recording Studio default layout, and FlatPack.</li>
          </ul>
        </div>
      <% end %>
    <% end %>

    <%= render FlatPack::Card::Component.new(border: :strong, shadow: :none) do |card| %>
      <% card.body do %>
        <div class="space-y-2">
          <div class="space-y-1">
            <h3 class="text-lg font-semibold leading-tight">Next steps</h3>
            <p class="text-sm leading-6 text-(--surface-muted-content-color)">The usual first moves when turning the template into a real addon.</p>
          </div>
          <ol class="space-y-3 text-sm leading-6 list-decimal pl-5">
            <li>Replace the sample migration with your addon tables and install them into the host app.</li>
            <li>Configure Recording Studio recordable types and capabilities in the host app initializer.</li>
            <li>Use the dummy app to validate layout, asset scanning, and authentication flows.</li>
          </ol>
        </div>
      <% end %>
    <% end %>

    <%= render FlatPack::Card::Component.new(border: :strong, shadow: :none) do |card| %>
      <% card.body do %>
        <div class="space-y-2">
          <div class="space-y-1">
            <h3 class="text-lg font-semibold leading-tight">FlatPack usage</h3>
            <p class="text-sm leading-6 text-(--surface-muted-content-color)">This page uses FlatPack components for its primary UI structure.</p>
          </div>
          <p class="text-sm leading-6 text-(--surface-content-color)">
            Use FlatPack cards, buttons, badges, inputs, and layout primitives as the default path for addon UI. Keep raw HTML for simple semantic content only.
          </p>
        </div>
      <% end %>

      <% card.footer do %>
        <a href="https://github.com/bowerbird-app/flatpack"
           target="_blank"
           rel="noopener noreferrer"
           class="inline-flex">
          <%= render FlatPack::Button::Component.new(
            text: "View FlatPack documentation",
            style: :primary,
            size: :md
          ) %>
        </a>
      <% end %>
    <% end %>

    <%= render FlatPack::Card::Component.new do |card| %>
      <% card.body do %>
        <div class="space-y-2">
          <div class="space-y-1">
            <h3 class="text-lg font-semibold leading-tight">Install flow</h3>
            <p class="text-sm leading-6 text-(--surface-muted-content-color)">What the host app generator path covers.</p>
          </div>
          <ul class="space-y-3 text-sm leading-6">
            <li>Add the gem to your host app and run <code>bundle install</code>.</li>
            <li>Run <code>rails generate recording_studio_dashboard:install</code> to mount the engine and add configuration.</li>
            <li>Run <code>rails generate recording_studio_dashboard:migrations</code> to copy engine migrations into the host app.</li>
            <li>Rebuild Tailwind if needed with <code>bin/rails tailwindcss:build</code>.</li>
          </ul>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
