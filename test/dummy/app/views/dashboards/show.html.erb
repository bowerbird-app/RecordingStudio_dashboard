<% dummy_page_nav(title: "Studio", back_url: root_path) %>

<div class="fp-on-backdrop mb-6 flex flex-wrap gap-2">
  <%= render FlatPack::Button::Component.new(text: "Home", href: root_path, style: :ghost, size: :sm) %>
  <%= render FlatPack::Button::Component.new(text: "Carousel", href: dashboard_path("carousel"), style: :ghost, size: :sm) %>
  <%= render FlatPack::Button::Component.new(text: "Expanded", href: dashboard_path("expanded"), style: :ghost, size: :sm) %>
  <%= render FlatPack::Button::Component.new(text: "Empty", href: dashboard_path("empty"), style: :ghost, size: :sm) %>
  <%= render FlatPack::Button::Component.new(text: "Personalised", href: dashboard_path("personalised"), style: :ghost, size: :sm) %>
  <% if @board %>
    <%= render FlatPack::Button::Component.new(text: "Saved board", href: studio_board_path(@board), style: :ghost, size: :sm) %>
  <% end %>
</div>

<%= render RecordingStudioDashboard.component(@definition_id, context: @context, actor: current_user) %>
